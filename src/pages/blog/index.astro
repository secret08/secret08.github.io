---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
---

<Base title="博客" active="blog">
  <h1 class="page-title">博客</h1>
  <p class="page-desc">共 {posts.length} 篇。想说的长话写在这里。</p>

  {
    posts.length === 0 ? (
      <p class="empty">还没有文章。</p>
    ) : (
      <div class="post-list">
        {posts.map((post) => (
          <a class="post-item" href={`/blog/${post.id}/`}>
            <div class="post-head">
              <h2 class="post-title">{post.data.title}</h2>
              <time class="post-date" datetime={post.data.date.toISOString()}>
                {fmt(post.data.date)}
              </time>
            </div>
            {post.data.summary && <p class="post-summary">{post.data.summary}</p>}
            {post.data.tags.length > 0 && (
              <div class="tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </a>
        ))}
      </div>
    )
  }
</Base>
