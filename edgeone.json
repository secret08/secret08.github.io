{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/vault.enc",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, private, max-age=0"
        },
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ],
  "caches": [{ "source": "/vault.enc", "cacheTtl": 0 }],
  "redirects": [
    { "source": "/vault/", "destination": "/#vault", "statusCode": 301 },
    { "source": "/vault", "destination": "/#vault", "statusCode": 301 },
    { "source": "/vault/index.html", "destination": "/#vault", "statusCode": 301 }
  ]
}
